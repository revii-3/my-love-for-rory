<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>For My Dearest Rory 💕☹️🫶</title>
  <link href="https://googleapis.com" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: linear-gradient(135deg, #ffb7c5 0%, #ffc8d6 50%, #ff9eb5 100%);
      min-height: 100vh;
      font-family: 'Quicksand', sans-serif;
      overflow-x: hidden;
      position: relative;
      padding: 70px 16px 50px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    #snowCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }
    #musicBadge {
      position: fixed;
      top: 16px;
      background: rgba(255, 255, 255, 0.32);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.65);
      color: #ffffff;
      padding: 9px 20px;
      border-radius: 50px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      z-index: 10;
      box-shadow: 0 4px 15px rgba(214, 51, 108, 0.18);
      text-shadow: 0 1px 4px rgba(180, 40, 90, 0.45);
    }
    .scrapbook-layout {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 28px;
      max-width: 1200px;
      width: 100%;
      position: relative;
      z-index: 2;
    }
    .photo-column {
      display: flex;
      flex-direction: column;
      gap: 22px;
      width: 210px;
      flex-shrink: 0;
    }
    .polaroid {
      background: #ffffff;
      padding: 10px 10px 26px 10px;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(180, 40, 90, 0.18);
      text-align: center;
      transition: transform 0.25s ease;
    }
    .polaroid:nth-child(odd) { transform: rotate(-3deg); }
    .polaroid:nth-child(even) { transform: rotate(3deg); }
    .polaroid:hover { transform: scale(1.05) rotate(0deg); }
    .polaroid img {
      width: 100%;
      height: 185px;
      object-fit: cover;
      border-radius: 4px;
      background-color: #ffe3ec;
      display: block;
    }
    .polaroid span {
      display: block;
      margin-top: 8px;
      font-family: 'Patrick Hand', cursive;
      font-size: 16px;
      color: #d6336c;
    }
    .notebook-paper {
      flex: 1;
      max-width: 620px;
      background-color: #fffdf9;
      border-radius: 12px;
      box-shadow: 0 18px 40px rgba(180, 40, 90, 0.22);
      position: relative;
      padding: 44px 36px 48px 64px;
      background-image: repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 33px,
        #ffd6e0 34px
      );
      line-height: 34px;
      overflow: hidden;
    }
    .notebook-paper::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 46px;
      width: 2px;
      background-color: #ff8fa3;
    }
    .washi-tape {
      position: absolute;
      top: -10px;
      left: 50%;
      transform: translateX(-50%) rotate(-2deg);
      width: 140px;
      height: 28px;
      background: rgba(255, 143, 163, 0.55);
      border-left: 2px dashed rgba(255, 255, 255, 0.7);
      border-right: 2px dashed rgba(255, 255, 255, 0.7);
      z-index: 3;
    }
    .letter-header {
      font-family: 'Caveat', cursive;
      font-size: 36px;
      font-weight: 700;
      color: #d6336c;
      margin-bottom: 14px;
      line-height: 40px;
    }
    .letter-body {
      font-family: 'Patrick Hand', cursive;
      font-size: 21px;
      color: #4a3b42;
      line-height: 34px;
      white-space: pre-line;
    }
    .letter-signoff {
      font-family: 'Caveat', cursive;
      font-size: 32px;
      font-weight: 700;
      color: #d6336c;
      margin-top: 24px;
      line-height: 36px;
      text-align: right;
    }
    @media (max-width: 900px) {
      .scrapbook-layout { flex-direction: column; align-items: center; }
      .photo-column { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 100%; gap: 12px; }
      .polaroid { width: 30%; min-width: 100px; padding: 6px 6px 16px 6px; }
      .polaroid img { height: 115px; }
      .notebook-paper { width: 100%; padding: 36px 20px 40px 46px; }
      .notebook-paper::before { left: 32px; }
      .letter-body { font-size: 19px; }
    }
  </style>
</head>
<body onclick="startMusic()">
  <div id="musicBadge">🎵 Tap anywhere for Lover Is a Day - Cuco</div>
  <div id="ytPlayer" style="position: fixed; width: 0; height: 0; opacity: 0; pointer-events: none;"></div>
  <canvas id="snowCanvas"></canvas>

  <div class="scrapbook-layout">
    <div class="photo-column">
      <div class="polaroid">
        <img src="illit1.jpg" alt="ILLIT 1" onerror="this.src='https://placehold.co'">
        <span>ILLIT 🌸</span>
      </div>
      <div class="polaroid">
        <img src="illit2.jpg" alt="ILLIT 2" onerror="this.src='https://placehold.co'">
        <span>For You 💕</span>
      </div>
      <div class="polaroid">
        <img src="illit3.jpg" alt="ILLIT 3" onerror="this.src='https://placehold.co'">
        <span>Cute ✨</span>
      </div>
    </div>

    <div class="notebook-paper">
      <div class="washi-tape"></div>
      <div class="letter-header">To my dearest Rory, 💕🫶</div>
      <div class="letter-body">I wanted to make this little space just for you, so whenever you look at it, you are reminded of how deeply loved and appreciated you are.

From the moment you came into my life, you have brought so much warmth, kindness, and light into my days. Loving you as a person—your heart, your smile, your strength, and everything that makes you who you are—is the greatest gift I have ever been given.

I want you to know that I am right here beside you through every single moment. You never have to carry anything alone. Every laugh we share, every quiet moment, and every second I get to spend loving you means the entire world to me.

Thank you for being you, for letting me love you, and for being my favorite person in the whole universe. I appreciate you more than words could ever fit onto paper, today and always.</div>
      <div class="letter-signoff">Forever yours, with all my heart 💖🌸</div>
    </div>

    <div class="photo-column">
      <div class="polaroid">
        <img src="sophia1.jpg" alt="Sophia KATSEYE 1" onerror="this.src='https://placehold.co'">
        <span>Sophia 🫶</span>
      </div>
      <div class="polaroid">
        <img src="sophia2.jpg" alt="Sophia KATSEYE 2" onerror="this.src='https://placehold.co'">
        <span>KATSEYE 💖</span>
      </div>
      <div class="polaroid">
        <img src="sophia3.jpg" alt="Sophia KATSEYE 3" onerror="this.src='https://placehold.co'">
        <span>Always 🌸</span>
      </div>
    </div>
  </div>

  <script src="https://youtube.com"></script>
  <script>
    let player;
    let musicStarted = false;
    function onYouTubeIframeAPIReady() {
      player = new YT.Player('ytPlayer', {
        height: '0',
        width: '0',
        videoId: '9wiEM0s4a3c',
        playerVars: { autoplay: 0, loop: 1, playlist: '9wiEM0s4a3c' }
      });
    }
    function startMusic() {
      if (!musicStarted && player && typeof player.playVideo === 'function') {
        player.playVideo();
        musicStarted = true;
        document.getElementById('musicBadge').innerText = '🎶 Now Playing: Lover Is a Day - Cuco';
      }
    }
    const canvas = document.getElementById('snowCanvas');
    const ctx = canvas.getContext('2d');
    let width = canvas.width = window.innerWidth;
    let height = canvas.height = window.innerHeight;
    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });
    const snowflakes = Array.from({ length: 95 }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      r: Math.random() * 3.5 + 1.5,
      speedY: Math.random() * 1.4 + 0.6,
      speedX: (Math.random() - 0.5) * 0.8,
      opacity: Math.random() * 0.6 + 0.4
    }));
    function drawSnow() {
      ctx.clearRect(0, 0, width, height);
      for (const flake of snowflakes) {
        ctx.beginPath();
        ctx.arc(flake.x, flake.y, flake.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${flake.opacity})`;
        ctx.shadowBlur = 6;
        ctx.shadowColor = '#ffffff';
        ctx.fill();
        flake.y += flake.speedY;
        flake.x += flake.speedX;
        if (flake.y > height) { flake.y = -5; flake.x = Math.random() * width; }
        if (flake.x > width) flake.x = 0;
        if (flake.x < 0) flake.x = width;
      }
      requestAnimationFrame(drawSnow);
    }
    drawSnow();
  </script>
</body>
</html>
